# ========================================================
# TUTOR IA - VARIÁVEIS DE AMBIENTE
# ========================================================
# Copie este arquivo para ".env" (uso local) ou cadastre cada variável no painel da
# plataforma de nuvem (Render, Railway...). NUNCA envie o .env com chaves reais ao Git.
# O app funciona sem nenhuma variável: usa o modo demonstração e as portas padrão.

# --- Servidor ---------------------------------------------------------------
# Porta (em nuvem a plataforma define PORT sozinha; não precisa configurar)
PORT=3000
# Endereço de escuta (0.0.0.0 aceita conexões da rede/nuvem)
HOST=0.0.0.0
# Abrir o navegador ao iniciar localmente (desativado automaticamente em nuvem/produção)
# OPEN_BROWSER=false

# --- Proxy / IP do cliente --------------------------------------------------
# Atrás de proxy (Render, Railway, Fly...) o IP real vem em X-Forwarded-For.
# Em nuvem o app liga isto sozinho; localmente o padrão é false.
# TRUST_PROXY=true
# Modo mais seguro: número de proxies confiáveis na frente do app (use o último IP do cabeçalho)
# TRUST_PROXY_HOPS=1
# Libera um site externo a chamar a API (por padrão, só o próprio app acessa)
# CORS_ORIGIN=https://meu-site.com

# --- Armazenamento ----------------------------------------------------------
# Driver de dados (por enquanto só "json")
STORAGE_DRIVER=json
# Pasta de usuários e sessões. EM NUVEM, aponte para um volume persistente (ex.: /var/data);
# em disco efêmero tudo é apagado a cada deploy.
DATA_DIR=./data

# --- Inteligência artificial (opcional) -------------------------------------
# Com GEMINI_API_KEY o app usa o Gemini; sem ela, usa OPENAI_API_KEY; sem nenhuma, modo demonstração.
GEMINI_API_KEY=
# Modelo padrão: gemini-3.8-flash (o gemini-1.5-flash foi desligado pelo Google em 29/09/2025)
# Confira os modelos vigentes em https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Tempo máximo de espera pela IA, em milissegundos (padrão 30000)
# AI_TIMEOUT_MS=30000

# --- Limites de requisições (por janela, em memória) ------------------------
# Login e cadastro, por IP: 10 a cada 15 minutos
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Explicações e questionários, por usuário (ou IP se visitante): 30 por hora
# TUTOR_RATE_LIMIT_MAX_REQUESTS=30
# TUTOR_RATE_LIMIT_WINDOW_MS=3600000
